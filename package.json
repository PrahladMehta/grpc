{
  "name": "grpc",
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start --filter=@upa/user-service --filter=@upa/llm-service",
    "db:setup": "turbo run db:setup",
    "client": "npm run start -w @upa/client"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
